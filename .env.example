# 복사해서 .env로 저장한 뒤 값을 채운다. .env는 커밋하지 않는다.

# SSAFY GMS (OpenAI 호환) - 필수
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Hugging Face 토큰 - 선택 (없으면 gated 모델의 config.json은 건너뛴다)
HF_TOKEN=

# 위키백과 OAuth 2.0 액세스 토큰 - 선택 (없으면 IP 기준 분당 10회 한도, 있으면 계정 기준 분당 200회)
# 발급: https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration/propose/oauth2
#       "owner-only" 체크, 권한은 "Basic rights"만 선택 -> 승인 즉시 Access token 표시
WIKI_ACCESS_TOKEN=

# 외부 API User-Agent에 넣을 연락처: 이메일 또는 저장소 URL (NF2006, 위키백과 User-Agent 정책) - 필수
CONTACT_INFO=
